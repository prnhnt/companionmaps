# --- server ---
PORT=8787
# Comma-separated origins allowed to hit the API/WebSocket. "*" in dev only.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# How often the hub flushes batched position updates to each client (ms).
BROADCAST_INTERVAL_MS=1000
# A member with no fix newer than this is marked "stale".
STALE_AFTER_MS=45000
# ...and dropped from the convoy entirely after this.
OFFLINE_AFTER_MS=300000
# Max positions kept per member for the breadcrumb trail.
TRAIL_LENGTH=120

# --- free geo providers (no API key required) ---
# OSRM routing. The public demo server is rate-limited and NOT for production;
# self-host (docker run osrm/osrm-backend) and point this at it before shipping.
OSRM_URL=https://router.project-osrm.org
# Nominatim geocoding. Usage policy: max 1 req/s, descriptive User-Agent required.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Sent as User-Agent to Nominatim. Put a real contact address here.
GEO_CONTACT=companionmaps-dev (set GEO_CONTACT to your contact email)

# --- web (Vite) ---
VITE_API_URL=http://localhost:8787
# MapLibre style. Leave unset to use the bundled OSM raster style.
# VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json
